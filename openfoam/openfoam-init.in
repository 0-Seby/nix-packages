# Fast OpenFOAM environment loader.
#
# The full OpenFOAM bashrc spawns hundreds of subprocesses for path
# manipulation, which costs ~3 s on Nix. We pre-compute its output at
# build time and store it in @out@/etc/openfoam-env.sh. This script
# replays that environment; only $HOME and $USER expand at runtime.
#
# Caveats:
#   * Configuration is baked in. Setting WM_COMPILE_OPTION, WM_MPLIB,
#     etc. before sourcing this has NO effect -- rebuild the derivation.
#   * Functions defined by the bashrc (foamEtcFile, foamCleanPath, ...)
#     remain available and behave as before.
#
_of_self="${BASH_SOURCE[0]:-$0}"
_of_root="$(dirname "$(dirname "$_of_self")")"

_of_prev_path="${PATH-}"
_of_prev_ld="${LD_LIBRARY_PATH-}"

# Captured env lives at a fixed store path (baked at build time). This is
# found even through a NixOS profile that doesn't link our etc/ dir, and it's
# identical across the base/withPackages/nixGL variants so baking it is safe.
source "@envCache@"

# foam-bin stays RELATIVE to how we were invoked (unresolved), so the nixGL
# symlinkJoin's wrapped GUI bins win over the core copies the env put on PATH.
# If a restrictive profile didn't link it, skip it -- on NixOS nixGL is a
# no-op, so the core GUI bins already on PATH are correct anyway.
if [ -d "$_of_root/foam-bin" ]; then
    export PATH="$_of_root/foam-bin:$PATH"
fi

[ -n "$_of_prev_path" ] && export PATH="$PATH:$_of_prev_path"
if [ -n "$_of_prev_ld" ]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}${LD_LIBRARY_PATH:+:}$_of_prev_ld"
fi
unset _of_prev_path _of_prev_ld _of_self _of_root
