# Fast OpenFOAM environment loader for fish.
# See openfoam-init for the rationale; same idea in fish syntax.

# Find our own directory so foam-bin resolves to the derivation
# we were sourced from (openfoam OR openfoam-nixgl).
set -l _of_self (status --current-filename)
set -l _of_root (dirname (dirname $_of_self))

set -l _of_prev_path $PATH
set -l _of_prev_ld $LD_LIBRARY_PATH

source "@envCache@"

if test -d "$_of_root/foam-bin"
    set -gx PATH "$_of_root/foam-bin" $PATH
end

if set -q _of_prev_path[1]
    set -gx PATH $PATH $_of_prev_path
end
if set -q _of_prev_ld[1]
    if set -q LD_LIBRARY_PATH[1]
        set -gx LD_LIBRARY_PATH $LD_LIBRARY_PATH $_of_prev_ld
    else
        set -gx LD_LIBRARY_PATH $_of_prev_ld
    end
end
